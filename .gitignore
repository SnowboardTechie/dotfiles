.DS_Store
__pycache__/
*.py[cod]
!AGENTS.md
configstore
dot-gitconfig.github
dot-gitconfig.local
dot-gitconfig.snowboardtechie

# Workspace-owned state that must never land here, even on hosts (Omarchy)
# where the global ignore file is not deployed
.hermes/
/vault

# ~/.config is one stow-folded symlink to dot-config/, so every tool writes its
# config, tokens, and runtime state straight into this repo. Allowlist the
# managed tools; anything new stays ignored until it gets its own line here.
dot-config/*
!dot-config/alacritty/
!dot-config/atuin/
!dot-config/direnv/
!dot-config/gh-dash/
!dot-config/git/
!dot-config/herdr/
!dot-config/nvim/
!dot-config/opencode/
!dot-config/shell/
!dot-config/worktrunk/
!dot-config/pi-durable/
!dot-config/zed/
!dot-config/zsh/

# Opencode - track config and lock files, ignore local artifacts
dot-config/opencode/*
!dot-config/opencode/
!dot-config/opencode/package.json
!dot-config/opencode/bun.lock
!dot-config/opencode/opencode.json
!dot-config/opencode/oh-my-openagent.json
!dot-config/opencode/AGENTS.md
!dot-config/opencode/agents/
!dot-config/opencode/plugins/
dot-config/opencode/plugins/*
!dot-config/opencode/plugins/ollama-models.js
!dot-config/opencode/plugins/worktrunk-guard.js
dot-config/alacritty/alacritty.toml

# Claude Code - track personal config and authored content, ignore local artifacts
dot-claude/*
!dot-claude/
!dot-claude/CLAUDE.md
!dot-claude/settings.json
!dot-claude/agents/
!dot-claude/scripts/
!dot-claude/scheduled-tasks/
!dot-claude/hud/
# Runtime log from the SessionStart hook script
dot-claude/scripts/symlink-worktree-agents-md.log

# Secrets - machine-specific, never committed
.secrets/

# GPG - only track gpg-agent.conf, ignore everything else
dot-gnupg/*
!dot-gnupg/gpg-agent.conf

# Stale backups from opencode config edits
*.backup*

# Machine-generated Git LFS hooks in the global hooks directory
dot-git-hooks/post-checkout
dot-git-hooks/post-commit
dot-git-hooks/post-merge
dot-git-hooks/pre-push

# Zed - track settings/keymap, ignore the LMDB prompt-library store (machine-local, binary)
dot-config/zed/prompts/

# Herdr - track config and status commands, ignore runtime state
dot-config/herdr/*
!dot-config/herdr/config.toml
!dot-config/herdr/config-omarchy.toml
!dot-config/herdr/claude-usage.sh
!dot-config/herdr/codex-usage.py
!dot-config/herdr/openrouter-spend.py
!dot-config/herdr/host-label.sh
!dot-config/herdr/AGENTS.md

# Pi Durable - track each workspace's config by exact filename; tokens, the
# Claude config directory, backups and any new file stay ignored
dot-config/pi-durable/*
!dot-config/pi-durable/sgg.json
!dot-config/pi-durable/planning.json
!dot-config/pi-durable/subscriptions.json

# Apple Notes native helper — built artifacts and signing material never tracked
dot-agents/skills/apple-notes-pkm/helper/*.app
dot-agents/skills/apple-notes-pkm/helper/*.o
dot-agents/skills/apple-notes-pkm/helper/apple-notes-pkm-helper
