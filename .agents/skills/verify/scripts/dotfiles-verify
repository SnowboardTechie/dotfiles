#!/usr/bin/env bash
# dotfiles-verify: drive this repository's reconcilers and setup scripts the
# way a host runs them, in a disposable HOME inside a macOS sandbox that can
# write nowhere else and reach no network. See ../SKILL.md.
#
#   dotfiles-verify doctor
#   dotfiles-verify journeys
#   dotfiles-verify run <journey | path/to/journey.sh>
#   dotfiles-verify cleanup [run directory]
set -uo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REPO_ROOT="$(cd "$SKILL_DIR/../../.." && pwd -P)"
JOURNEY_DIR="$SKILL_DIR/journeys"
EVIDENCE_ROOT="${DOTFILES_VERIFY_EVIDENCE:-${TMPDIR:-/tmp}/dotfiles-verify}"
# Tools a reconciler may need, linked by name into each run's tool directory.
# pi, claude, omarchy, systemctl, wl-paste and launchctl are deliberately not
# here: a journey that wants one writes a stub with `stub`.
TOOLS=(bash python3 jq perl git node realpath)

usage() {
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

die() { echo "dotfiles-verify: $*" >&2; exit 2; }

# canon_dir <path>: the canonical path of a directory that exists. Fails, and
# never runs `cd ""` (which stays in place under bash before 5.3), for an empty
# path or one that is not a directory.
canon_dir() {
    [[ -n "${1:-}" && -d "$1" ]] || return 1
    (cd "$1" && pwd -P)
}

# tmp_parent: the canonical temporary directory every scratch and probe is made
# in. Fails with the reason when $TMPDIR (or /tmp) is unusable.
tmp_parent() {
    local want="${TMPDIR:-/tmp}" canon
    canon="$(canon_dir "$want")" || { echo "temporary directory '$want' does not exist or is not a directory" >&2; return 1; }
    [[ -n "$canon" && "$canon" == /* && "$canon" != / ]] || { echo "temporary directory '$want' resolves to '$canon'" >&2; return 1; }
    [[ -w "$canon" ]] || { echo "temporary directory '$canon' is not writable" >&2; return 1; }
    echo "$canon"
}

# is_generated <path> <prefix>: 0 only for a non-empty path that is exactly
# <canonical temp dir>/<prefix>.XXXXXX, and none of the checkout, $HOME or /.
is_generated() {
    local path="${1:-}" prefix="$2" parent
    [[ -n "$path" ]] || return 1
    parent="$(tmp_parent 2>/dev/null)" || return 1
    [[ "$path" != / && "$path" != "$REPO_ROOT" && "$path" != "${HOME:-/}" ]] || return 1
    [[ "$path" =~ ^"$parent"/"$prefix"\.[A-Za-z0-9]{6}$ ]]
}

# make_tmp <prefix>: mktemp -d in the temp dir, checked; prints the canonical
# path or exits 2 with the reason. Nothing is ever used from a failed mktemp.
make_tmp() {
    local prefix="$1" parent made canon
    parent="$(tmp_parent)" || die "cannot make a $prefix directory: see above"
    made="$(mktemp -d "$parent/$prefix.XXXXXX")" || die "mktemp failed in $parent"
    [[ -n "$made" && -d "$made" && ! -L "$made" ]] || die "mktemp returned '$made', not a new directory"
    canon="$(canon_dir "$made")" || die "cannot resolve '$made'"
    is_generated "$canon" "$prefix" || die "mktemp returned '$canon', not $parent/$prefix.XXXXXX"
    echo "$canon"
}

# remove_tmp <path> <prefix>: rm -rf, but only of a directory make_tmp could
# have made. Anything else is refused and left alone.
remove_tmp() {
    if is_generated "${1:-}" "$2" && [[ -d "$1" && ! -L "$1" ]]; then
        rm -rf "$1"
    elif [[ -n "${1:-}" && ( -e "$1" || -L "$1" ) ]]; then
        echo "dotfiles-verify: refused to remove '$1': not a $2.XXXXXX directory in the temporary directory" >&2
        return 1
    fi
}

evidence_root() {
    [[ -n "$EVIDENCE_ROOT" ]] || die "no evidence root"
    mkdir -p "$EVIDENCE_ROOT" || die "cannot create evidence root $EVIDENCE_ROOT"
    local root
    root="$(canon_dir "$EVIDENCE_ROOT")" || die "cannot resolve evidence root $EVIDENCE_ROOT"
    case "$root/" in
        "$REPO_ROOT"/*) die "evidence root $root is inside the repository; set DOTFILES_VERIFY_EVIDENCE elsewhere" ;;
    esac
    echo "$root"
}

# A sandbox profile that allows writes only under the given directories.
profile() {
    local p='(version 1)(allow default)(deny network*)(deny file-write*)(allow file-write* (literal "/dev/null") (literal "/dev/tty") (regex #"^/dev/fd/")'
    local d
    for d in "$@"; do p+=" (subpath \"$d\")"; done
    echo "$p)"
}

# ---- doctor -----------------------------------------------------------------

doctor() {
    local fails=0 t root probe
    ok()   { echo "ok    $1"; }
    bad()  { echo "FAIL  $1"; fails=$((fails + 1)); }
    [[ "$(uname -s)" == Darwin ]] && ok "platform: macOS" || bad "platform: $(uname -s); the sandbox needs macOS sandbox-exec"
    command -v sandbox-exec >/dev/null && ok "sandbox-exec: $(command -v sandbox-exec)" || bad "sandbox-exec missing"
    for t in "${TOOLS[@]}"; do
        command -v "$t" >/dev/null && ok "tool $t: $(command -v "$t")" || bad "tool $t missing"
    done
    if [[ "$(bash -c 'echo ${BASH_VERSINFO[0]}')" -ge 4 ]]; then ok "bash on PATH is version 4 or later"; else bad "bash on PATH is older than 4"; fi
    # Checked before anything is created under it: the default evidence root
    # lives in the temporary directory, and mkdir -p would make a missing one.
    local why
    if ! why="$(tmp_parent 2>&1)"; then
        bad "temporary directory: $why"
        echo "dotfiles-verify: stopping: every run needs a usable temporary directory" >&2
        return 1
    fi
    ok "temporary directory: $why"
    root="$(evidence_root)" && ok "evidence: $root" || bad "evidence root"
    # The sandbox must refuse a write outside the run's directories.
    probe="$(make_tmp dotfiles-verify-probe)" || return 1
    mkdir "$probe/allowed"
    if sandbox-exec -p "$(profile "$probe/allowed")" bash -c "echo x > '$probe/allowed/f' && ! { echo x > '$probe/denied'; } 2>/dev/null" \
        && [[ -f "$probe/allowed/f" && ! -e "$probe/denied" ]]; then
        ok "sandbox: writes inside the run allowed, outside refused"
    else
        bad "sandbox did not confine writes"
    fi
    remove_tmp "$probe" dotfiles-verify-probe || bad "probe directory not removed"
    local stale=0 r
    for r in "$root"/*/run.json; do
        [[ -f "$r" ]] || continue
        [[ "$(run_field "$r" state)" == cleaned ]] || { echo "note  not cleaned: $(dirname "$r")"; stale=$((stale + 1)); }
    done
    [[ $stale -eq 0 ]] && ok "runs: all cleaned" || bad "runs: $stale not cleaned; run: dotfiles-verify cleanup"
    [[ $fails -eq 0 ]]
}

# kill_tree <pid>: SIGTERM every descendant of pid (not pid itself), deepest first.
kill_tree() {
    local child
    for child in $(pgrep -P "$1"); do kill_tree "$child"; kill -TERM "$child" 2>/dev/null; done
}

# ---- run --------------------------------------------------------------------

# started <pid>: the process's start time, which with the pid names one process.
started() { LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | sed 's/  */ /g; s/^ //; s/ $//'; }

# run.json records the processes this run started (the run itself and the
# journey's subshell), each with its start time, the scratch directory and a
# random token. The token is also written into the scratch's marker file, so
# cleanup can tell that directory was made by this run.
write_run_json() { # <state>
    python3 - "$RUN_DIR/run.json" "$1" "$JOURNEY" "$REPO_ROOT" "$(git -C "$REPO_ROOT" rev-parse HEAD)" \
        "$SCRATCH" "$RUN_TOKEN" "$$" "$(started $$)" "${JOURNEY_PID:-}" "${JOURNEY_STARTED:-}" <<'PY'
import json, sys
path, state, journey, repo, head, scratch, token, pid, pid_start, jpid, jstart = sys.argv[1:]
procs = [{"role": "run", "pid": int(pid), "started": pid_start}]
if jpid:
    procs.append({"role": "journey", "pid": int(jpid), "started": jstart})
json.dump({"journey": journey, "repo": repo, "head": head, "scratch": scratch, "token": token,
           "processes": procs, "state": state}, open(path, "w"), indent=2)
open(path, "a").write("\n")
PY
}

log() { echo "$*" | tee -a "$RUN_DIR/log.txt"; }

# Helpers a journey uses. Each journey is a bash file sourced in a subshell.
SEQ=0
next() { SEQ=$((SEQ + 1)); printf '%02d' "$SEQ"; }

step() { log "step $*"; }

new_home() { # <name>  -> prints a fresh empty HOME path
    local h="$SCRATCH/homes/$1"
    mkdir -p "$h"
    echo "$h"
}

# stub <name> <body>: a command on PATH in front of the real tools. In the
# body, __CALLS__ is the call log for the current HOME, outside it, so a
# stub's log never shows up in a home's tree: calls <home> <name> reads it.
stub() {
    printf '#!/usr/bin/env bash\n%s\n' "${2//__CALLS__/$SCRATCH/calls/\$(basename \"\$HOME\")-$1}" >"$SCRATCH/stubs/$1"
    chmod +x "$SCRATCH/stubs/$1"
}

calls() { cat "$SCRATCH/calls/$(basename "$1")-$2" 2>/dev/null; }

# stub_pi: a `pi` that records each call (calls <home> pi) and edits
# packages in $HOME/.pi/agent/settings.json the way `pi install`/`pi remove` do.
# Plus a `claude` that does nothing, so the Claude Code reconciler runs.
stub_pi() {
    stub pi 'echo "$*" >>"__CALLS__"
python3 - "$HOME/.pi/agent/settings.json" "$1" "$2" <<"PY"
import json, os, sys
p, op, src = sys.argv[1:]
os.makedirs(os.path.dirname(p), exist_ok=True)
d = json.load(open(p)) if os.path.exists(p) else {}
pk = d.setdefault("packages", [])
if op == "install" and src not in pk:
    pk.append(src)
elif op == "remove":
    d["packages"] = [x for x in pk if x != src]
json.dump(d, open(p, "w"), indent=2)
PY'
    stub claude 'exit 0'
}

# mattpocock_upstream: the sandbox has no network, so give git a local
# stand-in for Matt Pocock's skills repository holding the pinned commit.
# Copies it from the checkout the real reconciler keeps (read only). Never
# reaches the network: without the pin there, the journey fails and says why.
# Sets GIT_UPSTREAM_ENV to pass to `drive`.
mattpocock_upstream() {
    local source_record="$REPO/dot-agents/upstreams/mattpocock-skills.json" url pin src
    url="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["upstream"])' "$source_record")"
    pin="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["commit"])' "$source_record")"
    # Where the real reconciler keeps its checkout: ~/.local/share on current
    # main, ~/.pi/agent/upstreams before that. Read only.
    local candidates=("$HOME/.local/share/mattpocock-skills" "$HOME/.pi/agent/upstreams/mattpocock-skills") c
    [[ -z "${DOTFILES_VERIFY_MATTPOCOCK_SOURCE:-}" ]] || candidates=("$DOTFILES_VERIFY_MATTPOCOCK_SOURCE")
    src=""
    for c in "${candidates[@]}"; do
        if git -C "$c" cat-file -e "$pin^{commit}" 2>/dev/null; then src="$c"; break; fi
    done
    [[ -n "$src" ]] \
        || fail "setup: the pinned commit $pin of $url is in none of: ${candidates[*]}. Run the real scripts/reconcile-mattpocock-skills.sh --apply, or set DOTFILES_VERIFY_MATTPOCOCK_SOURCE to a local clone that has it. This command never fetches it."
    git clone --quiet --bare --no-local "$src" "$SCRATCH/mattpocock-skills.git" || fail "setup: cannot copy $src"
    git -C "$SCRATCH/mattpocock-skills.git" cat-file -e "$pin^{commit}" || fail "stand-in upstream lacks the pin $pin"
    MATTPOCOCK_PIN="$pin"
    GIT_UPSTREAM_ENV=(GIT_CONFIG_COUNT=1 "GIT_CONFIG_KEY_0=url.$SCRATCH/mattpocock-skills.git.insteadOf" "GIT_CONFIG_VALUE_0=$url")
    log "  stand-in upstream for $url at $SCRATCH/mattpocock-skills.git"
}

# drive <label> <home> [VAR=value ...] -- <command> [args...]
# Runs the command with HOME=<home>, a clean environment and the run's PATH,
# inside the sandbox. Sets RC and OUT; writes NN-<label>.txt.
drive() {
    local label="$1" home="$2"; shift 2
    local envs=()
    while [[ $# -gt 0 && "$1" != "--" ]]; do envs+=("$1"); shift; done
    [[ "${1:-}" == "--" ]] && shift
    next >/dev/null
    local file="$RUN_DIR/$(printf '%02d' "$SEQ")-$label.txt"
    OUT="$(cd "$home" && sandbox-exec -p "$(profile "$SCRATCH")" \
        env -i HOME="$home" PATH="$SCRATCH/stubs:$SCRATCH/tools:/usr/bin:/bin:/usr/sbin:/sbin" \
        TMPDIR="$SCRATCH/tmp" LANG=en_US.UTF-8 PYTHONDONTWRITEBYTECODE=1 ${envs[@]+"${envs[@]}"} "$@" 2>&1)"
    RC=$?
    {
        printf 'command: %s\n' "$*"
        printf 'home: %s\n' "$home"
        [[ ${#envs[@]} -gt 0 ]] && printf 'env: %s\n' "${envs[*]}"
        printf 'exit: %s\n\n%s\n' "$RC" "$OUT"
    } >"$file"
    log "  drive $label: exit $RC ($(basename "$file"))"
}

# tree <home>: every path under it, links with their targets, files with a hash.
tree() {
    local entry
    find "$1" -mindepth 1 | LC_ALL=C sort | while IFS= read -r entry; do
        if [[ -L "$entry" ]]; then
            echo "${entry#"$1"/} -> $(readlink "$entry")"
        elif [[ -f "$entry" ]]; then
            echo "${entry#"$1"/} $(shasum -a 256 "$entry" | cut -c1-16)"
        else
            echo "${entry#"$1"/}/"
        fi
    done
}

# capture <home> <label>: writes NN-<label>.tree and sets TREE to its path.
capture() {
    next >/dev/null
    TREE="$RUN_DIR/$(printf '%02d' "$SEQ")-$2.tree"
    tree "$1" >"$TREE"
}

fail() { log "FAIL: $*"; exit 1; }

# expect <claim> <command...>: the claim must hold, or the journey fails here.
expect() {
    local claim="$1"; shift
    if "$@"; then log "  ok   $claim"; else fail "$claim"; fi
}

has() { grep -qF -- "$2" <<<"$1"; }          # has <text> <fixed string>
lacks() { ! grep -qF -- "$2" <<<"$1"; }
same_file() { cmp -s "$1" "$2"; }
links_to() { [[ -L "$1" && "$(readlink -f "$1")" == "$(readlink -f "$2")" ]]; }

run_journey() {
    local arg="$1" file
    if [[ -f "$arg" ]]; then file="$(cd "$(dirname "$arg")" && pwd -P)/$(basename "$arg")"
    elif [[ -f "$JOURNEY_DIR/$arg.sh" ]]; then file="$JOURNEY_DIR/$arg.sh"
    else die "no journey '$arg'; see: dotfiles-verify journeys"; fi
    JOURNEY="$(basename "$file" .sh)"
    command -v sandbox-exec >/dev/null || die "sandbox-exec missing; this harness runs only on macOS (see doctor)"
    tmp_parent >/dev/null || die "every run needs a usable temporary directory"
    local root; root="$(evidence_root)" || exit 2
    RUN_DIR="$root/$(date -u +%Y%m%dT%H%M%SZ)-$JOURNEY"
    while [[ -e "$RUN_DIR" ]]; do RUN_DIR="$RUN_DIR-x"; done
    mkdir -p "$RUN_DIR"
    SCRATCH="$(make_tmp dotfiles-verify-scratch)" || exit 2
    RUN_TOKEN="$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
    write_marker
    mkdir -p "$SCRATCH/homes" "$SCRATCH/calls" "$SCRATCH/stubs" "$SCRATCH/tools" "$SCRATCH/tmp"
    local t
    for t in "${TOOLS[@]}"; do ln -s "$(command -v "$t")" "$SCRATCH/tools/$t"; done
    # The sandbox stops file writes and network, not IPC: launchctl would still
    # reach the real launchd. These stand in for every host-level command a
    # script here may call, log the call, and succeed. A journey can replace one.
    for t in launchctl systemctl stow sudo brew defaults; do stub "$t" 'echo "$*" >>"__CALLS__"'; done
    # A neutral host name, so no Studio-only or Gnarbox-only branch runs by accident.
    for t in scutil hostname; do stub "$t" 'echo verify-host'; done
    write_run_json running
    # On a signal, stop the journey (this run's own children, by parent pid) and
    # remove the scratch; cleanup may already have marked the run cleaned.
    trap 'kill_tree $$; [[ "$(run_field "$RUN_DIR/run.json" state)" == cleaned ]] || write_run_json interrupted; remove_tmp "$SCRATCH" dotfiles-verify-scratch; exit 130' INT TERM
    log "run $RUN_DIR"
    log "journey $file"
    log "repo $REPO_ROOT at $(git -C "$REPO_ROOT" rev-parse --short HEAD)$( [[ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]] && echo ' (with local changes)')"
    log "scratch $SCRATCH"
    # In the background and waited for, so the journey's pid is recorded before
    # it does anything, and a signal to the run is handled at once.
    ( set +e; REPO="$REPO_ROOT"; source "$file" ) &
    JOURNEY_PID=$!
    JOURNEY_STARTED="$(started "$JOURNEY_PID")"
    write_marker
    write_run_json running
    wait "$JOURNEY_PID"
    local rc=$?
    if [[ $rc -eq 0 ]]; then log "PASSED"; else log "FAILED"; fi
    write_run_json finished
    cleanup_run "$RUN_DIR" >/dev/null
    return $(( rc == 0 ? 0 : 1 ))
}

# ---- cleanup ----------------------------------------------------------------

MARKER=.dotfiles-verify-run

# The marker inside the scratch: the run's token and directory, then one line
# per process this run started, "<role> <pid> <start time>". Cleanup takes the
# processes to stop from here, never from run.json, and only once the scratch
# itself has been validated.
write_marker() {
    {
        printf '%s\n%s\n' "$RUN_TOKEN" "$RUN_DIR"
        printf 'run %s %s\n' "$$" "$(started $$)"
        [[ -z "${JOURNEY_PID:-}" ]] || printf 'journey %s %s\n' "$JOURNEY_PID" "$JOURNEY_STARTED"
    } >"$SCRATCH/$MARKER.tmp" && mv "$SCRATCH/$MARKER.tmp" "$SCRATCH/$MARKER"
}

# The directory every run's scratch is made in, canonical.
scratch_parent() { tmp_parent; }

run_field() { # <run.json> <key>  -> the value, or nothing when unreadable
    python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1]))[sys.argv[2]])
except Exception: pass' "$1" "$2"
}

# owned_scratch <run dir> <run.json>: prints the scratch path when it is safe to
# remove, else explains on stderr and fails. Safe means: canonical, a real
# directory (not a link) directly in this machine's temporary directory, named
# exactly dotfiles-verify-scratch.XXXXXX, holding a marker whose token and run
# directory match this run.
owned_scratch() {
    local dir="$1" json="$2" scratch token parent canon
    scratch="$(run_field "$json" scratch)"; token="$(run_field "$json" token)"
    parent="$(scratch_parent)" || return 1
    [[ -n "$scratch" && -n "$token" ]] || { echo "no scratch or token recorded" >&2; return 1; }
    # The recorded path itself must have the exact generated shape, so no
    # traversal or other directory can pass even when it does not exist.
    [[ "$scratch" =~ ^"$parent"/dotfiles-verify-scratch\.[A-Za-z0-9]{6}$ ]] \
        || { echo "'$scratch' is not $parent/dotfiles-verify-scratch.XXXXXX" >&2; return 1; }
    [[ -e "$scratch" || -L "$scratch" ]] || { echo "ABSENT"; return 0; }
    [[ ! -L "$scratch" && -d "$scratch" ]] || { echo "'$scratch' is not a real directory" >&2; return 1; }
    canon="$(canon_dir "$scratch")" || { echo "cannot resolve '$scratch'" >&2; return 1; }
    [[ "$canon" == "$scratch" ]] || { echo "'$scratch' is not canonical (resolves to '$canon')" >&2; return 1; }
    [[ "$(dirname "$canon")" == "$parent" ]] || { echo "'$canon' is not directly in $parent" >&2; return 1; }
    [[ "$(basename "$canon")" =~ ^dotfiles-verify-scratch\.[A-Za-z0-9]{6}$ ]] || { echo "'$canon' does not have the generated name" >&2; return 1; }
    [[ -f "$canon/$MARKER" && ! -L "$canon/$MARKER" ]] || { echo "'$canon' has no marker" >&2; return 1; }
    [[ "$(sed -n 1p "$canon/$MARKER")" == "$token" && "$(sed -n 2p "$canon/$MARKER")" == "$dir" ]] \
        || { echo "'$canon' marker names another run" >&2; return 1; }
    echo "$canon"
}

# stop_recorded <validated scratch>: SIGTERM each process the run's marker
# records (journey first, its descendants before it), only while that pid still
# has the recorded start time and runs `dotfiles-verify run`.
stop_recorded() {
    local role pid start
    while read -r role pid start; do
        [[ "$pid" =~ ^[0-9]+$ && "$pid" != "$$" && -n "$start" ]] || continue
        if [[ "$(started "$pid")" == "$start" ]] \
            && ps -o command= -p "$pid" | grep -qE '(^|/| )dotfiles-verify run '; then
            kill_tree "$pid"
            kill -TERM "$pid" 2>/dev/null || true
            echo "      stopped $role process $pid"
        fi
    done < <(tail -n +3 "$1/$MARKER" | sort)   # "journey" sorts before "run"
}

cleanup_run() { # <run dir>
    local dir json scratch
    dir="$(canon_dir "${1:-}")" || { echo "skip  '${1:-}' (not a directory)"; return 1; }
    json="$dir/run.json"
    [[ -f "$json" && ! -L "$json" ]] || { echo "skip  $dir (no run.json)"; return 1; }
    [[ "$(run_field "$json" state)" == cleaned ]] && { echo "ok    $dir (already cleaned)"; return 0; }
    # Validate the scratch before stopping anything: a run.json that fails here
    # was not written by a run of this command, and nothing it names is touched.
    if ! scratch="$(owned_scratch "$dir" "$json" 2>"$dir/.cleanup-refusal")"; then
        echo "REFUSED $dir: $(cat "$dir/.cleanup-refusal"); nothing stopped or removed"
        rm -f "$dir/.cleanup-refusal"
        return 1
    fi
    rm -f "$dir/.cleanup-refusal"
    # An absent scratch proves nothing about the run's processes: stop none.
    if [[ "$scratch" != ABSENT ]]; then
        stop_recorded "$scratch"
        sleep 1
        remove_tmp "$scratch" dotfiles-verify-scratch || return 1
    fi
    python3 -c 'import json,sys
d = json.load(open(sys.argv[1])); d["state"] = "cleaned"
json.dump(d, open(sys.argv[1], "w"), indent=2)' "$json"
    echo "ok    $dir cleaned; evidence kept"
}

cleanup() {
    tmp_parent >/dev/null || die "cleanup needs a usable temporary directory to validate scratch paths"
    if [[ $# -gt 0 ]]; then cleanup_run "$1"; return; fi
    local root r rc=0; root="$(evidence_root)" || exit 2
    for r in "$root"/*/run.json; do [[ -f "$r" ]] && { cleanup_run "$(dirname "$r")" || rc=1; }; done
    return $rc
}

# Sourced (cleanup-proof uses canon_dir, make_tmp and remove_tmp from here):
# define the functions and stop.
[[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0

case "${1:-}" in
    doctor) doctor ;;
    journeys) for f in "$JOURNEY_DIR"/*.sh; do printf '%-18s %s\n' "$(basename "$f" .sh)" "$(sed -n '2s/^# //p' "$f")"; done ;;
    run) [[ $# -eq 2 ]] || die "usage: dotfiles-verify run <journey>"; run_journey "$2" ;;
    cleanup) shift; cleanup "$@" ;;
    -h|--help|"") usage; [[ -n "${1:-}" ]] ;;
    *) usage >&2; exit 2 ;;
esac
