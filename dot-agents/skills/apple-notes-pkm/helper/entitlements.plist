<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime apps may send Apple Events to other apps only with this
	     entitlement; without it every send fails -1743 and no prompt appears. It is
	     the sole entitlement: no network, disk, or other automation surface. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
