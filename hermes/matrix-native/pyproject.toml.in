[project]
name = "hermes-matrix-native-deps"
version = "1.1.0"
requires-python = "@PYTHON_RANGE@"
# Studio-native only: PM locks one universal graph for every OS, and the
# patched python-olm wheel exists only for macOS arm64.
dependencies = [
  "mautrix[encryption]==0.21.1; sys_platform == 'darwin' and platform_machine == 'arm64'",
  "asyncpg==0.31.0; sys_platform == 'darwin' and platform_machine == 'arm64'",
  "aiosqlite==0.22.1; sys_platform == 'darwin' and platform_machine == 'arm64'",
  "aiohttp-socks==0.11.0; sys_platform == 'darwin' and platform_machine == 'arm64'",
  "Markdown>=3.4,<4",
  "python-olm==3.2.16; sys_platform == 'darwin' and platform_machine == 'arm64'",
]

[tool.uv]
package = false

[tool.uv.sources]
python-olm = { path = @WHEEL_PATH@, marker = "sys_platform == 'darwin' and platform_machine == 'arm64'" }
